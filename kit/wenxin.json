  "decisions": [
    {
      "id": "D-1",
      "title": "语义色缺失"
    },
    {
      "id": "D-2",
      "title": "danger 与 accent-hover 撞色"
    },
    {
      "id": "D-3",
      "title": "主提交与反馈收束按钮可以填充"
    },
    {
      "id": "D-4",
      "title": "卡片：保留禁令，但改写措辞"
    },
    {
      "id": "D-5",
      "title": "F7 海报的 accent 规则与 Web 不同"
    },
    {
      "id": "D-6",
      "title": "图表不引入分类色板"
    },
    {
      "id": "D-7",
      "title": "骨架屏不做"
    },
    {
      "id": "D-8",
      "title": "弃置 opendesign 适配层"
    },
    {
      "id": "D-9",
      "title": "暗色 accent 不达 AA"
    },
    {
      "id": "D-10",
      "title": "functional ink 从生产站反哺 token"
    },
    {
      "id": "D-11",
      "title": "`wx-entry` 增加连续流，不增加卡片"
    },
    {
      "id": "D-12",
      "title": "真实内容站上的 accent 预算分两种判法"
    },
    {
      "id": "D-13",
      "title": "暗色触发方式可多样，暗色 accent 不可漂"
    },
    {
      "id": "D-14",
      "title": "F1 的 40em 长文与作者侧栏"
    },
    {
      "id": "D-15",
      "title": "F6 允许三轨，不允许缺地标"
    },
    {
      "id": "D-16",
      "title": "字体策略按成本适配，F6 CDN 不适配"
    },
    {
      "id": "D-17",
      "title": "上线不豁免目标尺寸、状态树与对比度"
    },
    {
      "id": "D-18",
      "title": "品牌呼吸按页面任务，不按组件存在"
    },
    {
      "id": "D-19",
      "title": "F7 社交卡片旧协议不并入现行规范"
    },
    {
      "id": "D-20",
      "title": "文字灰阶从六档收到四档"
    },
    {
      "id": "D-21",
      "title": "浮层可以有\"面\"，但只借这一样"
    },
    {
      "id": "D-22",
      "title": "禁令要能被检查到，否则等于不存在"
    },
    {
      "id": "D-23",
      "title": "两种排除不是一回事"
    },
    {
      "id": "D-24",
      "title": "拖放区可以是四边框"
    },
    {
      "id": "D-25",
      "title": "九形态不再是文档的组织方式"
    },
    {
      "id": "D-26",
      "title": "删除九份夹具，连同它们喂养的检查"
    },
    {
      "id": "D-27",
      "title": "删除分媒介整包"
    },
    {
      "id": "D-28",
      "title": "对比度要按\"面\"测，不是按\"页面底色\"测"
    },
    {
      "id": "D-29",
      "title": "■ 是文字署名的一部分，不是游离 accent"
    }

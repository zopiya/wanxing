{
  "name": "wenxin-wanxing",
  "version": "0.1.0",
  "summary": "文心 · 万形 — 内容型产品的设计语言。文字即界面，留白即设计，克制即力量。",
  "invariant": {
    "note": "不变之魂。改动这三条，产物就不再属于这套语言；要改，先在 spec/DECISIONS.md 立一条待议项。",
    "axes": [
      "A9 克制之美",
      "B9 温暖极简",
      "D9 暖土调"
    ]
  },
  "arbitration": {
    "note": "冲突判定，自上而下三层。设计哲学约 60%，主流惯例约 40% — 比例是这三层产生的结果，不是口味。",
    "layers": [
      {
        "layer": 1,
        "name": "全局底线",
        "rule": "无障碍与基本可用性，惯例无条件优先，两条轨道都适用。",
        "covers": [
          "WCAG 2.2 AA 对比度",
          "可见焦点态",
          "键盘可达",
          "触控目标尺寸",
          "颜色不作唯一信息载体",
          "prefers-reduced-motion"
        ]
      },
      {
        "layer": 2,
        "name": "按形态分轨",
        "rule": "阅读轨全量应用视觉约束；应用轨放宽。页面级声明 track。",
        "note": "采用页面原型 E（工具/表单）的页面会翻转它所在形态的轨道。"
      },
      {
        "layer": 3,
        "name": "组件类别覆盖",
        "rule": "数据录入与反馈类组件永远按惯例处理，无论所在轨道。表单就是表单。"
      }
    ]
  },
  "exclusions": {
    "note": "两种排除不是一回事（D-23）。理由是「这违反我们相信的东西」的不会回来；理由是「暂时用不上」的，范围扩大后已经实现了。",
    "philosophy": [
      "卡片",
      "spinner",
      "骨架屏",
      "自动轮播",
      "水印"
    ],
    "scopeResolved": [
      "滑块",
      "上传",
      "日期",
      "树",
      "气泡"
    ]
  },
  "forbidden": {
    "note": "The executable half of spec/soul/forbidden.md. check-forbidden.mjs reads `checkable`; nothing reads `judgement`, and that is the point — a rule a machine cannot decide must be marked as such, or its silence gets mistaken for a passing check (D-22).",
    "checkable": [
      {
        "id": "shadow",
        "spec": "forbidden.md §一",
        "track": "both",
        "why": "无阴影 — 伪造 z 轴纵深，与平面克制相悖",
        "pattern": "box-shadow\\s*:\\s*(?!none|0\\b|inherit|unset)",
        "flags": "i"
      },
      {
        "id": "gradient",
        "spec": "forbidden.md §二",
        "track": "both",
        "why": "无渐变",
        "pattern": "(linear|radial|conic)-gradient\\s*\\(",
        "flags": "i"
      },
      {
        "id": "outline-none",
        "spec": "forbidden.md §三 / A-2",
        "track": "both",
        "why": "禁止 outline:none — 焦点可见是第一层全局底线",
        "pattern": "outline\\s*:\\s*none",
        "flags": "i"
      },
      {
        "id": "bouncy-easing",
        "spec": "motion.md",
        "track": "both",
        "why": "禁止弹跳类缓动",
        "pattern": "\\b(spring|bounce|elastic)\\b|cubic-bezier\\([^)]*,\\s*-?\\d*\\.?\\d+\\s*,\\s*[^)]*,\\s*1\\.[1-9]",
        "flags": "i"
      },
      {
        "id": "thick-border",
        "spec": "forbidden.md §一",
        "track": "both",
        "why": "边框 >1px（--stroke-mark 的 1.5px 描边除外）",
        "pattern": "border(-(top|right|bottom|left|inline|block)(-(start|end))?)?(-width)?\\s*:\\s*(?:[^;]*\\s)?([2-9]|\\d{2,})(\\.\\d+)?px",
        "flags": "i",
        "allow": "var\\(--stroke-mark\\)|1\\.5px"
      },
      {
        "id": "spinner",
        "spec": "motion.md",
        "track": "both",
        "why": "禁止旋转 spinner — 无限循环动画",
        "pattern": "animation[^;]*\\brotate\\b|@keyframes\\s+[\\w-]*spin",
        "flags": "i"
      }
    ],
    "judgement": [
      {
        "id": "card-geometry",
        "spec": "forbidden.md §一",
        "track": "editorial",
        "why": "四边包围的方框（边框 / 阴影 / 填充底色三者任一 + 圆角），用来把一组内容\"装起来\"",
        "uncheckable": "静态 CSS 分不出内容容器与控件。按钮、标签、输入框、kbd 以及 D-21 明确许可的浮层都合法地同时具备边框与圆角；一条 naive 规则在本仓库命中 60 次、几乎全是误报。",
        "instead": "用 wx-entry：单边线 + 留白"
      },
      {
        "id": "background-partition",
        "spec": "forbidden.md §一（色块背景分区）",
        "track": "editorial",
        "why": "用色块背景把内容分区",
        "uncheckable": "background 的合法用途太多——行内代码、输入框、分组列表、提示块都要用。是否构成\"分区\"取决于轨道与意图。",
        "instead": "用留白分区"
      },
      {
        "id": "accent-budget",
        "spec": "aesthetics.md / brand.md",
        "track": "editorial",
        "why": "每页至多两处强调色出现",
        "uncheckable": "需要按渲染后的页面计数，且要区分装饰性出现与状态色。render-audit 的 findAccentOccurrences() 在单页范围内可以执行，全仓库静态扫描不行。",
        "instead": "对合同化输出运行 npm exec --no -- wenxin audit dist/<slug>/index.html；外链 CSS 与动作语义仍需人工审阅"
      },
      {
        "id": "filled-primary-semantics",
        "spec": "forbidden.md §三 / DECISIONS.md D-3",
        "track": "both",
        "why": "真实数据录入提交或反馈收束可使用一处填充主按钮；应用轨还可将这一处用于直接推进当前任务，阅读轨导航 CTA 用文字链接",
        "uncheckable": "静态 HTML 无法可靠判断一个链接是在导航、反馈后的安全出口，还是应用轨的任务推进；全页数 wx-btn--primary 会误杀合法的反馈收束与组件示例。自动门当前只覆盖阅读轨 D 型着陆，不能外推为所有页面的动作分类或视图边界。",
        "instead": "声明页面轨道与原型；按 D-3 人工审阅动作语义，并保留 D 型页面的自动审计"
      },
      {
        "id": "decorative-illustration",
        "spec": "forbidden.md",
        "track": "editorial",
        "why": "空态与结果页不用装饰插画",
        "uncheckable": "机器分不出装饰图与信息图。",
        "instead": "标题先说明状态，动作是可命名的 button/link"
      }
    ]
  },

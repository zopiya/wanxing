{
  "name": "wenxin-wanxing",
  "version": "0.1.0",
  "description": "文心 · 万形 — 内容型产品的设计语言与前端组件库。零运行时依赖。",
  "homepage": "https://zopiya.github.io/wanxing/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zopiya/wanxing.git"
  },
  "bugs": {
    "url": "https://github.com/zopiya/wanxing/issues"
  },
  "author": "Zopiya <i@zopiya.com>",
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "wcag",
    "chinese-typography",
    "llms-txt"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "wenxin": "./bin/wenxin.mjs"
  },
  "exports": {
    ".": "./kit/index.css",
    "./css": "./kit/dist/wenxin.css",
    "./contracts": "./kit/wenxin.json",
    "./tokens": "./kit/tokens/generated/tokens.json",
    "./tokens/dtcg": "./kit/tokens/generated/tokens.dtcg.json",
    "./patterns/*": "./kit/patterns/*"
  },
  "files": [
    "bin/",
    "kit/",
    "scripts/render-audit.mjs",
    "spec/",
    "AGENTS.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:tokens && npm run build:themes && npm run build:contracts && npm run build:css && npm run build:site && npm run build:llms",
    "build:tokens": "node scripts/build-tokens.mjs",
    "audit": "node scripts/render-audit.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check": "npm run check:tokens && npm run check:colors && npm run check:forbidden && npm run check:components && npm run check:contracts && npm run check:site && npm run check:site:selftest && npm run check:site-motion && npm run check:pattern-tool && npm run check:calendar-demo && npm run check:entry-demo && npm run check:overlay && npm run check:rate && npm run check:display-feedback && npm run check:disclosure && npm run check:toc && npm run check:brand-assets && npm run check:markdown-admonitions && npm run check:llms && npm run check:render-audit && npm run check:a11y && npm run check:a11y:selftest && npm run check:components:selftest && npm run check:cli",
    "build:themes": "node scripts/build-themes.mjs",
    "build:css": "node scripts/build-css.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:site:selftest": "node tests/site-selftest.mjs",
    "check:site-motion": "node tests/site-motion-selftest.mjs",
    "check:pattern-tool": "node tests/pattern-tool-selftest.mjs",
    "check:calendar-demo": "node tests/calendar-demo-selftest.mjs",
    "check:entry-demo": "node tests/entry-demo-selftest.mjs",
    "check:overlay": "node tests/overlay-selftest.mjs",
    "check:rate": "node tests/rate-contract-selftest.mjs",
    "check:display-feedback": "node tests/display-feedback-truth-selftest.mjs",
    "check:disclosure": "node tests/disclosure-selftest.mjs",
    "check:toc": "node tests/toc-selftest.mjs",
    "check:brand-assets": "node tests/brand-assets-selftest.mjs",
    "check:markdown-admonitions": "node tests/markdown-admonitions-selftest.mjs",
    "check:render-audit": "node tests/render-audit-selftest.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:a11y:selftest": "node tests/a11y-selftest.mjs",
    "check:components": "node scripts/check-components.mjs",
    "check:components:selftest": "node tests/components-selftest.mjs",
    "build:contracts": "node scripts/build-contracts.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "build:llms": "node scripts/build-llms.mjs",
    "check:llms": "node scripts/check-llms.mjs",
    "check:cli": "node scripts/check-cli.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}

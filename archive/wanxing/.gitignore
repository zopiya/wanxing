# OpenCode runtime memory database
.memdb/

# macOS system files
.DS_Store

# Editor / IDE directories
.idea/
.vscode/

# Vim swap files
*.swp
*.swo
*~

# OS temporary files
Thumbs.db
/.memdb/
.synapse/

# Design output — generated project artifacts are untracked.
# The dist/ directory itself is tracked (via .gitkeep) so the folder
# always exists. Each project writes to dist/<project-slug>/.
dist/**
!dist/
!dist/.gitkeep

# Workbench dependencies
workbench/node_modules/
workbench/dist/

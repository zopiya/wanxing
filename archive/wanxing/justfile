# 万形 · Wanxing Task Runner
# HTTP Server 全局只运行一个实例，Audit Agent 直接复用。

port := env_var_or_default("WANXING_PORT", "8000")
root := env_var_or_default("WANXING_ROOT", "dist")
url := "http://localhost:" + port
log := "/tmp/wanxing-http-" + port + ".log"

# 启动 HTTP Server（幂等；已运行时不会重复启动）
serve:
	@if lsof -i :{{port}} -t >/dev/null 2>&1; then \
		if curl -fsS {{url}}/ >/dev/null; then \
			echo "HTTP server already running on port {{port}}"; \
		else \
			echo "Port {{port}} is in use, but {{url}} is not serving {{root}}/"; \
			echo "Set WANXING_PORT to another port or stop the conflicting process."; \
			exit 1; \
		fi; \
	else \
		echo "Starting HTTP server on port {{port}} from {{root}}..."; \
		cd {{root}} && nohup python3 -m http.server {{port}} > {{log}} 2>&1 & \
		sleep 1; \
		curl -fsS {{url}}/ >/dev/null && echo "HTTP server ready: {{url}}"; \
	fi

# 检查 HTTP Server 状态
status:
	@lsof -i :{{port}} -t >/dev/null 2>&1 && echo "HTTP server running on port {{port}}" || echo "No HTTP server on port {{port}}"

# 停止当前端口上的 HTTP Server
stop:
	@pids="$(lsof -i :{{port}} -t 2>/dev/null)"; \
	if [ -n "$pids" ]; then \
		kill $pids && echo "HTTP server stopped on port {{port}}"; \
	else \
		echo "No HTTP server to stop on port {{port}}"; \
	fi

# 轻量校验
validate:
	@python3 -m json.tool opencode.json >/dev/null
	@test -d dist
	@test -d app
	@test -f .opencode/agents/audit/AGENT.md
	@test -f .opencode/rules/motion-spec.md
	@if find . -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*screenshot*' \) -print -quit | grep -q .; then \
		echo "Root screenshot artifact found; move screenshots to dist/<project-slug>/tmp/screenshots/"; \
		exit 1; \
	fi
	@git diff --check
	@git diff --cached --check
	@echo "Validation passed"

# Render Contract 审计（只读，JSON 输出到 stdout）
audit file:
	@bun .opencode/tools/render-audit/render-audit.mjs {{file}}

# 启动 Workbench（HTTP Server + Vite dev server）
workbench:
	@just serve
	@cd workbench && bun run dev

# 仅启动 Workbench Vite dev server
workbench-dev:
	@cd workbench && bun run dev

# 完整启动：OpenCode Serve + Vite dev server
workbench-full:
	@just opencode-serve
	@cd workbench && bun run dev

# OpenCode Serve 端口
oc-port := env_var_or_default("OPENCODE_PORT", "4096")
oc-url := "http://localhost:" + oc-port

# 启动 OpenCode Serve（幂等；已运行时不会重复启动）
opencode-serve:
	@if lsof -i :{{oc-port}} -t >/dev/null 2>&1; then \
		if curl -fsS {{oc-url}}/api/session >/dev/null 2>&1; then \
			echo "OpenCode Serve already running on port {{oc-port}}"; \
		else \
			echo "Port {{oc-port}} is in use, but OpenCode Serve API is not responding"; \
			echo "Set OPENCODE_PORT to another port or stop the conflicting process."; \
			exit 1; \
		fi; \
	else \
		echo "Starting OpenCode Serve on port {{oc-port}}..."; \
		nohup opencode serve --hostname=127.0.0.1 --port={{oc-port}} > /tmp/opencode-serve-{{oc-port}}.log 2>&1 & \
		sleep 2; \
		curl -fsS {{oc-url}}/api/session >/dev/null 2>&1 && echo "OpenCode Serve ready: {{oc-url}}"; \
	fi

# 检查 OpenCode Serve 状态
opencode-status:
	@if lsof -i :{{oc-port}} -t >/dev/null 2>&1; then \
		if curl -fsS {{oc-url}}/api/session >/dev/null 2>&1; then \
			echo "OpenCode Serve running on port {{oc-port}}"; \
		else \
			echo "Port {{oc-port}} in use but API not responding"; \
		fi; \
	else \
		echo "No OpenCode Serve on port {{oc-port}}"; \
	fi

# 停止 OpenCode Serve
opencode-stop:
	@pids="$(lsof -i :{{oc-port}} -t 2>/dev/null)"; \
	if [ -n "$pids" ]; then \
		kill $pids && echo "OpenCode Serve stopped on port {{oc-port}}"; \
	else \
		echo "No OpenCode Serve to stop on port {{oc-port}}"; \
	fi
